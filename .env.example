# ZPPZ Arena 环境变量示例
#
# 后端在启动时会自动加载当前目录下的 `.env` 文件（python-dotenv）。
# 本地开发请先复制本文件：`cp .env.example .env`，然后按需修改。
# 生产环境由 systemd 的 EnvironmentFile 或部署流水线注入，无需提交真实值。

# --- 基础 ---
DATABASE_URL=sqlite:///./zppz_v2.db
# 本地开发使用上面的相对路径；生产环境由 systemd EnvironmentFile 注入 /opt/zppz/data/zppz_v2.db。
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000
# false keeps session cookies usable on local HTTP. An unset value follows
# PUBLIC_BASE_URL (https:// enables Secure). Production deploy writes true
# when the key is missing and does not overwrite an explicit false.
SECURE_COOKIES=false
# IPs or CIDRs allowed to supply X-Forwarded-For and X-Real-IP. Only the
# immediate TCP peer is trusted. Host nginx on loopback matches the default.
# Docker Compose overrides this with private ranges because its nginx
# container is not loopback.
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
SESSION_COOKIE_NAME=zppz_session
SESSION_EXPIRE_HOURS=168
# --- 投稿校验 ---
# Optional path to the sandboxed Rust archive validator. When unset, the backend
# looks for backend/bin/zppz-chart-validate and falls back to the Python path.
# ZPPZ_CHART_VALIDATE_BIN=/usr/local/bin/zppz-chart-validate
SUBMISSION_VALIDATION_TIMEOUT_SECONDS=300

# --- 签名密钥（生产环境必须使用独立生成的高强度随机值，切勿使用示例值） ---
SECRET_KEY=replace-with-a-long-random-value
WEBHOOK_SIGNING_MASTER_KEY=replace-with-an-independent-long-random-value

# --- 管理员初始化（`python -m app.prepare` 仅在设置了密码时创建默认管理员） ---
ADMIN_SEED_CODE=admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# --- 外部 Ban 曲 / 元数据查询（预留接口，默认禁用） ---
BAN_EXTERNAL_PROVIDER=disabled
BAN_EXTERNAL_API_URL=
BAN_EXTERNAL_API_KEY=
BAN_EXTERNAL_TIMEOUT_MS=2000
BAN_EXTERNAL_CACHE_TTL_SECONDS=604800

# --- Webhook（外部 Bot 谱面发布/更新推送） ---
WEBHOOK_SCAN_INTERVAL_SECONDS=2
WEBHOOK_ASSET_URL_TTL_SECONDS=604800
WEBHOOK_ASSET_RETENTION_DAYS=30

# --- 对象存储（本地或 Cloudflare R2） ---
OBJECT_STORAGE_BACKEND=local
# Production uses r2 and receives these values from GitHub Actions.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_INTENT_TTL_SECONDS=900

# --- 谱面预览（MiaView SDK）---
PREVIEW_ENABLED=false
# 指向已发布的 sdk/index.mjs，例如 https://preview.przppz.club/miaview/<version>/sdk/index.mjs
PREVIEW_PLAYER_URL=
# 可选；默认由 PREVIEW_PLAYER_URL 把 /sdk/index.mjs 换成 /renderer/index.html
PREVIEW_RENDERER_URL=
PREVIEW_PLAYER_ORIGIN=http://localhost:4173
PREVIEW_URL_TTL_SECONDS=21600
PREVIEW_BACKFILL_POLL_SECONDS=2

# --- 可观测性（可选，空值表示关闭） ---
# 生产环境写在服务器 /opt/zppz/.env（systemd EnvironmentFile）。不要把真实 DSN 提交到仓库。
# 未设置 SENTRY_DSN 时，本地和 CI 不会向 Sentry 发送事件。
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 可选。未设置时，若发布包根目录有 REVISION（git sha），用它作为 Sentry release。
# SENTRY_RELEASE=
# 空值时 GET /api/v1/admin/metrics 只接受管理员登录态。不要把 token 放在 URL 查询参数里。
METRICS_TOKEN=

# --- 连接池 / 并发 ---
# SQLite must use 1 worker. PostgreSQL deployments should normally use 2.
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional: edit /opt/zppz/data/permissions.json on the server to force roles during `python -m app.prepare`.
