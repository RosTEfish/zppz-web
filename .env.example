DATABASE_URL=sqlite:////opt/zppz/data/zppz_v2.db
DATA_DIR=/opt/zppz/data
SECRET_KEY=replace-with-a-long-random-value
ADMIN_SEED_CODE=admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
SESSION_EXPIRE_HOURS=168
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost,http://127.0.0.1
MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=mp3,wav,flac,aac,m4a,ogg,zip,7z,rar

# Optional: edit /opt/zppz/data/permissions.json on the server to force roles on startup.
